# Copy to .env and adjust. All values are optional.

# --- LLM -------------------------------------------------------------------
# With no key the app uses a deterministic extractive mock so it still runs end to end.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# auto | anthropic | mock
LLM_PROVIDER=auto

# --- Retrieval ---------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Set false to run BM25-only (no model download).
EMBEDDINGS_ENABLED=true
RETRIEVAL_TOP_K=5
# Dense hits below this cosine similarity are treated as noise.
RETRIEVAL_MIN_SIMILARITY=0.15

# --- OCR (scanned / image-only PDFs) -----------------------------------------
# Uses Tesseract through PyMuPDF; only the language data (eng.traineddata) is needed.
# Pages with no text layer are OCR'd automatically; digital pages are left alone.
OCR_ENABLED=true
OCR_LANGUAGE=eng
# Auto-detected (TESSDATA_PREFIX, then standard Tesseract install folders). Set to override.
# OCR_TESSDATA_DIR=C:\Program Files\Tesseract-OCR\tessdata
OCR_DPI=300
OCR_MAX_PAGES=150

# --- Chunking / limits -------------------------------------------------------
CHUNK_TARGET_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
MAX_UPLOAD_MB=25

# --- Storage -----------------------------------------------------------------
# DATA_DIR=./data
